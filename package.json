{
  "name": "human-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/server.mjs",
    "preview": "node scripts/server.mjs --preview",
    "build:worker": "node scripts/build-worker.mjs",
    "build": "pnpm build:worker && vite build",
    "test": "pnpm build:worker && vitest run",
    "test:model": "vitest run tests/model.test.ts tests/history.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "lint": "biome check src worker tests scripts *.json *.ts index.html",
    "check": "pnpm typecheck && pnpm lint",
    "format": "biome check --write src worker tests scripts *.json *.ts index.html"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261001.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "^0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
